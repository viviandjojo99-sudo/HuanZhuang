+            if (defaultLayerOrder != null)
+                ApplyLayerOrder(defaultLayerOrder, notifySave: false, markCustom: false);
+            layerOrderCustomized = false;
+            if (notifySave)
+                NoteOutfitIfNeeded();
+        }
